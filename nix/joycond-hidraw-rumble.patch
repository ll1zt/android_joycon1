+/* 日志限流用的单调毫秒时钟（与 rumble_hidraw 内部同名逻辑独立，避免跨 TU 依赖） */
+static unsigned long ff_now_ms()
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ts.tv_sec * 1000UL + ts.tv_nsec / 1000000UL;
+}
+
 void virt_ctlr_combined::handle_uinput_event()
 {
     struct input_event ev;
@@ -91,11 +102,23 @@ void virt_ctlr_combined::handle_uinput_event()
         switch (ev.type) {
             case EV_FF:
                 {
+                    /* FF_GAIN / FF_AUTOCENTER 的 value 是 0..0xFFFF 的量值，不是 0/1
+                     * 播放开关；uinput 用 dev->event 覆盖了 input_ff_event，内核 ff core
+                     * 对注入的 EV_FF 不做任何 id 校验，所以这里必须自己挡掉野 code。 */
+                    if (ev.code >= FF_GAIN)
+                        break;
+
                     struct input_event redirectedl = ev;
