diff --git a/src/rumble_hidraw.cpp b/src/rumble_hidraw.cpp
new file mode 100644
index 0000000..2c14300
--- /dev/null
+++ b/src/rumble_hidraw.cpp
@@ -0,0 +1,146 @@
+#include "rumble_hidraw.h"
+#include "rumble_scale.h"
+
+#include <glob.h>
+#include <string.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <time.h>
+#include <iostream>
+
+// HF 频段选点:freq byte 0x04 起步(81.75Hz),步进 +0x04;0x20 ≈ 160Hz 附近
+#define HF_FREQ_DEFAULT 0x20
+// LF 频段选点:0x01(40.87Hz) - 0x7F(626Hz);普通震动的厚实感取 ~80Hz
+#define LF_FREQ_DEFAULT 0x14
+// LF 幅度编码:0x40 = 0.0f,0x72 = 1.0f(安全上限,文档明确警告超限伤 LRA)
+#define LF_AMP_OFF   0x40
+#define LF_AMP_MAX   0x72
+// HF 幅度编码:0x01 ≈ 0.0f,0xC8 = 1.0f
+#define HF_AMP_OFF   0x01
+#define HF_AMP_MAX   0xC8
+
+static const unsigned char NEUTRAL[4] = { 0x00, 0x01, 0x40, 0x40 };
+// 同参数最小重发间隔(ms),防止 play 风暴打爆蓝牙链路(0x30 报告仍在 60Hz 抢带宽)
+#define MIN_INTERVAL_MS 10
+
+static unsigned long now_ms()
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ts.tv_sec * 1000UL + ts.tv_nsec / 1000000UL;
+}
+
+float joycond_rumble_scale = 1.0f;
+
+rumble_hidraw::rumble_hidraw() : fd(-1), pkt_num(0), last_send_ms(0), is_left(false)
+{
+}
+
+rumble_hidraw::~rumble_hidraw()
+{
+    close();
+}
+
+int rumble_hidraw::find_hidraw_fd(const std::string &devpath)
+{
+    // devpath = /class/input/eventX ; hidraw 是其 HID 父设备的兄弟节点
+    std::string glob_pat = "/sys" + devpath + "/device/hidraw/hidraw*";
+    glob_t gl;
+    memset(&gl, 0, sizeof(gl));
+    if (glob(glob_pat.c_str(), 0, NULL, &gl) != 0 || gl.gl_pathc == 0) {
+        globfree(&gl);
+        return -1;
+    }
+    std::string name = gl.gl_pathv[0];
+    globfree(&gl);
+    size_t slash = name.find_last_of('/');
+    if (slash == std::string::npos)
+        return -1;
+    return open(("/dev/" + name.substr(slash + 1)).c_str(), O_WRONLY | O_NONBLOCK);
+}
+
+bool rumble_hidraw::open_for(const std::string &devpath, bool left)
+{
+    is_left = left;
+    close();
+    fd = find_hidraw_fd(devpath);
+    if (fd < 0)
+        std::cerr << "rumble_hidraw: no hidraw for " << devpath << std::endl;
+    return fd >= 0;
+}
+
+void rumble_hidraw::close()
+{
+    if (fd >= 0) {
+        ::close(fd);
+        fd = -1;
+    }
+}
+
+void rumble_hidraw::encode_band(unsigned char *out, unsigned char hf_freq,
+                                unsigned char hf_amp, unsigned char lf_freq,
+                                unsigned char lf_amp)
+{
+    out[0] = hf_freq;  // HF 频率
+    out[1] = hf_amp;   // HF 幅度
+    out[2] = lf_freq;  // LF 频率
+    out[3] = lf_amp;   // LF 幅度
+}
+
+int rumble_hidraw::write_report(const unsigned char self[4], bool is_left)
+{
+    unsigned char buf[0x40];
+    memset(buf, 0, sizeof(buf));
+    buf[0] = 0x10;                    // rumble-only 输出报告
+    buf[1] = pkt_num++;               // 包序号循环 0x0-0xF
+    pkt_num &= 0x0F;
+
+    if (is_left) {
+        memcpy(buf + 2, self, 4);     // 左手柄数据在前 4 字节
+        memcpy(buf + 6, NEUTRAL, 4);
+    } else {
+        memcpy(buf + 2, NEUTRAL, 4);
+        memcpy(buf + 6, self, 4);     // 右手柄数据在后 4 字节
+    }
+
+    return write(fd, buf, sizeof(buf));
+}
+
+void rumble_hidraw::send(unsigned short strong, unsigned short weak)
+{
+    if (fd < 0)
+        return;
+
+    unsigned long now = now_ms();
+    if (now - last_send_ms < MIN_INTERVAL_MS)
+        return;
+    last_send_ms = now;
+
+    unsigned char band[4];
+    // FF_RUMBLE: strong_magnitude = LF 马达语义, weak = HF;映射到双频带幅度
+    // 用户强度系数(WebUI --rumble-scale),clamp 到协议安全范围
+    {
+        float s = joycond_rumble_scale;
+        if (s < 0.05f) s = 0.05f;
+        if (s > 2.0f) s = 2.0f;
+        unsigned scaled_w = (unsigned)(weak * s);
+        unsigned scaled_s = (unsigned)(strong * s);
+        if (scaled_w > 0xFFFF) scaled_w = 0xFFFF;
+        if (scaled_s > 0xFFFF) scaled_s = 0xFFFF;
+        weak = scaled_w;
+        strong = scaled_s;
+    }
+    encode_band(band,
+                HF_FREQ_DEFAULT,
+                HF_AMP_OFF + (unsigned)weak * (HF_AMP_MAX - HF_AMP_OFF) / 0xFFFF,
+                LF_FREQ_DEFAULT,
+                LF_AMP_OFF + (unsigned)strong * (LF_AMP_MAX - LF_AMP_OFF) / 0xFFFF);
+    write_report(band, is_left);
+}
+
+void rumble_hidraw::stop()
+{
+    if (fd < 0)
+        return;
+    write_report(NEUTRAL, is_left);
+}
