+/* 被移除手柄的残留状态清零(键全部释放、轴回中),映射与 relay_events 一致 */
+void virt_ctlr_combined::clear_phys_state(std::shared_ptr<phys_ctlr> phys)
+{
+    struct libevdev *evdev = phys->get_evdev();
+    bool serial = phys->is_serial_ctlr();
+
+    for (int code = 0; code <= KEY_MAX; code++) {
+        if (!libevdev_has_event_code(evdev, EV_KEY, code))
+            continue;
+        if (libevdev_get_event_value(evdev, EV_KEY, code) == 0)
+            continue;
+
+        int out = code;
+        if (phys == physl && (code == BTN_TR || code == BTN_TR2)) {
+            if (!serial)
+                out = (code == BTN_TR) ? BTN_TRIGGER_HAPPY1 : BTN_TRIGGER_HAPPY2;
+        } else if (phys == physr && (code == BTN_TL || code == BTN_TL2)) {
+            if (!serial)
+                out = (code == BTN_TL) ? BTN_TRIGGER_HAPPY3 : BTN_TRIGGER_HAPPY4;
+        }
+#if defined(ANDROID) || defined(__ANDROID__)
+        else if (phys == physl && code == BTN_TL2) {
+            libevdev_uinput_write_event(uidev, EV_ABS, ABS_Z, 0);
+            continue;
+        } else if (phys == physr && code == BTN_TR2) {
+            libevdev_uinput_write_event(uidev, EV_ABS, ABS_RZ, 0);
+            continue;
+        } else if (code == BTN_DPAD_UP || code == BTN_DPAD_DOWN) {
+            libevdev_uinput_write_event(uidev, EV_ABS, ABS_HAT0Y, 0);
+            continue;
+        } else if (code == BTN_DPAD_LEFT || code == BTN_DPAD_RIGHT) {
+            libevdev_uinput_write_event(uidev, EV_ABS, ABS_HAT0X, 0);
+            continue;
+        } else if (code == BTN_TL2 || code == BTN_TR2) {
+            continue;   /* Android 合成设备未声明这两个键位 */
+        }
+#endif
+        libevdev_uinput_write_event(uidev, EV_KEY, out, 0);
+    }
+
+    /* 摇杆不在中位时掉线,游戏会看到摇杆一直偏向一边 */
+    for (int code = 0; code <= ABS_MAX; code++) {
+        if (!libevdev_has_event_code(evdev, EV_ABS, code))
+            continue;
+        if (libevdev_get_event_value(evdev, EV_ABS, code) == 0)
+            continue;
+        libevdev_uinput_write_event(uidev, EV_ABS, code, 0);
+    }
+    libevdev_uinput_write_event(uidev, EV_SYN, SYN_REPORT, 0);
+}
