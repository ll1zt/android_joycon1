@@ -0,0 +1,46 @@
+#ifndef JOYCOND_RUMBLE_HIDRAW_H
+#define JOYCOND_RUMBLE_HIDRAW_H
+
+#include <string>
+
+/*
+ * hidraw 直通震动发送器。
+ *
+ * 背景:GKI 内核的 hid-nintendo 编译时 CONFIG_NINTENDO_FF 未开启,
+ * 内核 FF 框架的 effect 永远不会被转成 0x10 震动报告发给手柄。
+ * 本模块绕过内核 FF,直接经 hidraw 写 BT OUTPUT 0x10 报告。
+ *
+ * 协议(dekuNukem/Nintendo_Switch_Reverse_Engineering,编码照内核
+ *   joycon_encode_rumble:幅度与频率共享字节):
+ *   OUTPUT 0x10: [0x10][pkt_num 0x0-0xF][左 JC 4字节][右 JC 4字节] 共 64 字节
+ *   每只手柄 4 字节 = [HF freq 高][HF freq 低 + HF amp][LF freq 低 + LF amp 高位][LF amp 低]
+ *   LF 幅度低字节安全上限 0x72;中性(关震) = 00 01 40 40
+ */
+class rumble_hidraw
+{
+    private:
+        int fd;
+        unsigned char pkt_num;
+        unsigned long last_send_ms;
+        bool is_left;
+
+        int find_hidraw_fd(const std::string &devpath);
+        int write_report(const unsigned char self[4], bool is_left);
+
+    public:
+        rumble_hidraw();
+        ~rumble_hidraw();
+        /* devpath 来自 Android 检测器，形如 /class/input/eventX/device（结尾带 /device）。
+         * 所以 glob 是 .../eventX/device/device/hidraw/hidraw* —— 两个 device 不是笔误：
+         * 第一个是 input 设备的父链，第二个才落到 HID 设备。改之前先读 HANDOFF.md §3
+         * 返回是否成功打开 hidraw */
+        bool open_for(const std::string &devpath, bool is_left);
+        bool is_open() const { return fd >= 0; }
+        /* strong/weak: FF_RUMBLE 的 0..0xFFFF 幅度,映射到 LF/HF 频段 */
+        void send(unsigned short strong, unsigned short weak);
+        /* 停震：连发 5 个中性包（对齐内核 JC_RUMBLE_ZERO_AMP_PKT_CNT，抗 BT 丢包） */
+        void stop();
+        void close();
+};
+
+#endif
