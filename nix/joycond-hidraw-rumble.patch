diff --git a/src/rumble_hidraw.cpp b/src/rumble_hidraw.cpp
new file mode 100644
index 0000000..5e581fa
--- /dev/null
+++ b/src/rumble_hidraw.cpp
@@ -0,0 +1,223 @@
+#include "rumble_hidraw.h"
+#include "rumble_scale.h"
+
+#include <glob.h>
+#include <string.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <time.h>
+#include <iostream>
+
+// ---- 内核 hid-nintendo 同款感知幅度表(dekuNukem 数据) ----
+//
+// 输入 0..1003(线性域)→ {HF 幅度字节, LF 幅度 16 位}。感受是对数域:
+// 旧实现按字节线性插值,输入 50% 时物理力度只有约 30%;照内核查表后
+// 50% 就是 50%(表中 0x59 ↔ 输入 34%、0x62 ↔ 输入 50%)。
+// 编码格式与内核 joycon_encode_rumble 严格一致(幅度与频率共享字节):
+//   band[1] = HF 频率低字节 + HF 幅度(0x00..0xC8,步进 2)
+//   band[2] = LF 频率低字节 + LF 幅度高位(0x80)
+//   band[3] = LF 幅度低字节(0x40..0x72)
+struct rumble_amp_data {
+    unsigned char hf;
+    unsigned short lf;
+    unsigned short amp;   // 输入域 0..1003
+};
+
+#define RUMBLE_MAX_AMP 1003
+static const struct rumble_amp_data RUMBLE_AMPS[] = {
+	{ 0x00, 0x0040, 0 }, { 0x02, 0x8040, 10 }, { 0x04, 0x0041, 12 } ,
+	{ 0x06, 0x8041, 14 }, { 0x08, 0x0042, 17 }, { 0x0a, 0x8042, 20 } ,
+	{ 0x0c, 0x0043, 24 }, { 0x0e, 0x8043, 28 }, { 0x10, 0x0044, 33 } ,
+	{ 0x12, 0x8044, 40 }, { 0x14, 0x0045, 47 }, { 0x16, 0x8045, 56 } ,
+	{ 0x18, 0x0046, 67 }, { 0x1a, 0x8046, 80 }, { 0x1c, 0x0047, 95 } ,
+	{ 0x1e, 0x8047, 112 }, { 0x20, 0x0048, 117 }, { 0x22, 0x8048, 123 } ,
+	{ 0x24, 0x0049, 128 }, { 0x26, 0x8049, 134 }, { 0x28, 0x004a, 140 } ,
+	{ 0x2a, 0x804a, 146 }, { 0x2c, 0x004b, 152 }, { 0x2e, 0x804b, 159 } ,
+	{ 0x30, 0x004c, 166 }, { 0x32, 0x804c, 173 }, { 0x34, 0x004d, 181 } ,
+	{ 0x36, 0x804d, 189 }, { 0x38, 0x004e, 198 }, { 0x3a, 0x804e, 206 } ,
+	{ 0x3c, 0x004f, 215 }, { 0x3e, 0x804f, 225 }, { 0x40, 0x0050, 230 } ,
+	{ 0x42, 0x8050, 235 }, { 0x44, 0x0051, 240 }, { 0x46, 0x8051, 245 } ,
+	{ 0x48, 0x0052, 251 }, { 0x4a, 0x8052, 256 }, { 0x4c, 0x0053, 262 } ,
+	{ 0x4e, 0x8053, 268 }, { 0x50, 0x0054, 273 }, { 0x52, 0x8054, 279 } ,
+	{ 0x54, 0x0055, 286 }, { 0x56, 0x8055, 292 }, { 0x58, 0x0056, 298 } ,
+	{ 0x5a, 0x8056, 305 }, { 0x5c, 0x0057, 311 }, { 0x5e, 0x8057, 318 } ,
+	{ 0x60, 0x0058, 325 }, { 0x62, 0x8058, 332 }, { 0x64, 0x0059, 340 } ,
+	{ 0x66, 0x8059, 347 }, { 0x68, 0x005a, 355 }, { 0x6a, 0x805a, 362 } ,
+	{ 0x6c, 0x005b, 370 }, { 0x6e, 0x805b, 378 }, { 0x70, 0x005c, 387 } ,
+	{ 0x72, 0x805c, 395 }, { 0x74, 0x005d, 404 }, { 0x76, 0x805d, 413 } ,
+	{ 0x78, 0x005e, 422 }, { 0x7a, 0x805e, 431 }, { 0x7c, 0x005f, 440 } ,
+	{ 0x7e, 0x805f, 450 }, { 0x80, 0x0060, 460 }, { 0x82, 0x8060, 470 } ,
+	{ 0x84, 0x0061, 480 }, { 0x86, 0x8061, 491 }, { 0x88, 0x0062, 501 } ,
+	{ 0x8a, 0x8062, 512 }, { 0x8c, 0x0063, 524 }, { 0x8e, 0x8063, 535 } ,
+	{ 0x90, 0x0064, 547 }, { 0x92, 0x8064, 559 }, { 0x94, 0x0065, 571 } ,
+	{ 0x96, 0x8065, 584 }, { 0x98, 0x0066, 596 }, { 0x9a, 0x8066, 609 } ,
+	{ 0x9c, 0x0067, 623 }, { 0x9e, 0x8067, 636 }, { 0xa0, 0x0068, 650 } ,
+	{ 0xa2, 0x8068, 665 }, { 0xa4, 0x0069, 679 }, { 0xa6, 0x8069, 694 } ,
+	{ 0xa8, 0x006a, 709 }, { 0xaa, 0x806a, 725 }, { 0xac, 0x006b, 741 } ,
+	{ 0xae, 0x806b, 757 }, { 0xb0, 0x006c, 773 }, { 0xb2, 0x806c, 790 } ,
+	{ 0xb4, 0x006d, 808 }, { 0xb6, 0x806d, 825 }, { 0xb8, 0x006e, 843 } ,
+	{ 0xba, 0x806e, 862 }, { 0xbc, 0x006f, 881 }, { 0xbe, 0x806f, 900 } ,
+	{ 0xc0, 0x0070, 920 }, { 0xc2, 0x8070, 940 }, { 0xc4, 0x0071, 960 } ,
+	{ 0xc6, 0x8071, 981 }, { 0xc8, 0x0072, RUMBLE_MAX_AMP } ,
+};
+
+// 与内核 joycon_find_rumble_amp 相同的区间查找:返回第一个 amp 入口 >= 输入
+static const struct rumble_amp_data *find_rumble_amp(unsigned short amp)
+{
+    const size_t n = sizeof(RUMBLE_AMPS) / sizeof(RUMBLE_AMPS[0]);
+    size_t i = 0;
+    if (amp > RUMBLE_AMPS[0].amp) {
+        for (i = 1; i < n - 1; i++) {
+            if (amp > RUMBLE_AMPS[i - 1].amp && amp <= RUMBLE_AMPS[i].amp)
+                break;
+        }
+    }
+    return &RUMBLE_AMPS[i];
+}
+
+// 固定频点(编码格式见上):HF 95Hz = {0x2000, 0x28},LF 62Hz = {0x0000, 0x14}。
+// 62Hz 贴近 Joy-Con LRA 谐振点,比内核默认的 160Hz 更响;95Hz 与旧实现宣称值一致。
+#define HF_FREQ_CODE_LOW 0x28
+#define LF_FREQ_CODE_LOW 0x14
+
+// 同参数最小重发间隔:0x10 报告的流式节奏上限 60Hz(hd-test 同款 16ms)。
+// 旧值 10ms=100Hz 超协议节奏,与 60Hz 的 0x30 输入报告抢 BT 带宽
+// (precheck 实测活跃操作时持续 dropped IMU reports)。
+#define MIN_INTERVAL_MS 16
+// 停震中性包连发次数:对齐内核 JC_RUMBLE_ZERO_AMP_PKT_CNT,抗 BT 丢包
+#define STOP_PKT_CNT 5
+
+static const unsigned char NEUTRAL[4] = { 0x00, 0x01, 0x40, 0x40 };
+
+static unsigned long now_ms()
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ts.tv_sec * 1000UL + ts.tv_nsec / 1000000UL;
+}
+
+float joycond_rumble_scale = 1.0f;
+
+rumble_hidraw::rumble_hidraw() : fd(-1), pkt_num(0), last_send_ms(0), is_left(false)
+{
+}
+
+rumble_hidraw::~rumble_hidraw()
+{
+    close();
+}
+
+int rumble_hidraw::find_hidraw_fd(const std::string &devpath)
+{
+    // devpath = /class/input/eventX ; hidraw 是其 HID 父设备的兄弟节点
+    std::string glob_pat = "/sys" + devpath + "/device/hidraw/hidraw*";
+    glob_t gl;
+    memset(&gl, 0, sizeof(gl));
+    if (glob(glob_pat.c_str(), 0, NULL, &gl) != 0 || gl.gl_pathc == 0) {
+        globfree(&gl);
+        return -1;
+    }
+    std::string name = gl.gl_pathv[0];
+    globfree(&gl);
+    size_t slash = name.find_last_of('/');
+    if (slash == std::string::npos)
+        return -1;
+    return open(("/dev/" + name.substr(slash + 1)).c_str(), O_WRONLY | O_NONBLOCK);
+}
+
+bool rumble_hidraw::open_for(const std::string &devpath, bool left)
+{
+    is_left = left;
+    close();
+    fd = find_hidraw_fd(devpath);
+    if (fd < 0)
+        std::cerr << "rumble_hidraw: no hidraw for " << devpath << std::endl;
+    return fd >= 0;
+}
+
+void rumble_hidraw::close()
+{
+    if (fd >= 0) {
+        ::close(fd);
+        fd = -1;
+    }
+}
+
+int rumble_hidraw::write_report(const unsigned char self[4], bool is_left)
+{
+    unsigned char buf[0x40];
+    memset(buf, 0, sizeof(buf));
+    buf[0] = 0x10;                    // rumble-only 输出报告
+    buf[1] = pkt_num++;               // 包序号循环 0x0-0xF
+    pkt_num &= 0x0F;
+
+    if (is_left) {
+        memcpy(buf + 2, self, 4);     // 左手柄数据在前 4 字节
+        memcpy(buf + 6, NEUTRAL, 4);
+    } else {
+        memcpy(buf + 2, NEUTRAL, 4);
+        memcpy(buf + 6, self, 4);     // 右手柄数据在后 4 字节
+    }
+
+    return write(fd, buf, sizeof(buf));
+}
+
+void rumble_hidraw::send(unsigned short strong, unsigned short weak)
+{
+    if (fd < 0)
+        return;
+
+    unsigned long now = now_ms();
+    if (now - last_send_ms < MIN_INTERVAL_MS)
+        return;
+    last_send_ms = now;
+
+    // 用户强度系数(WebUI --rumble-scale),先在线性输入域缩放,clamp 防溢出
+    {
+        float s = joycond_rumble_scale;
+        if (s < 0.05f) s = 0.05f;
+        if (s > 2.0f) s = 2.0f;
+        unsigned scaled_w = (unsigned)(weak * s);
+        unsigned scaled_s = (unsigned)(strong * s);
+        if (scaled_w > 0xFFFF) scaled_w = 0xFFFF;
+        if (scaled_s > 0xFFFF) scaled_s = 0xFFFF;
+        weak = scaled_w;
+        strong = scaled_s;
+    }
+
+    // FF_RUMBLE: strong = LF 马达语义, weak = HF。
+    // 与内核 joycon_play_effect 相同的两步:输入 0..0xFFFF 线性映射到 0..1003,
+    // 再查感知表。表里 amp=0 的首项保证零输入编出零幅度。
+    const struct rumble_amp_data *amp_lf =
+        find_rumble_amp((unsigned int)strong * RUMBLE_MAX_AMP / 0xFFFF);
+    const struct rumble_amp_data *amp_hf =
+        find_rumble_amp((unsigned int)weak * RUMBLE_MAX_AMP / 0xFFFF);
+
+    unsigned char band[4];
+    band[0] = 0x20;                                 // HF 频率高字节(95Hz)
+    band[1] = HF_FREQ_CODE_LOW + amp_hf->hf;        // HF 频率低字节 + HF 幅度
+    band[2] = LF_FREQ_CODE_LOW + (amp_lf->lf >> 8); // LF 频率低字节 + LF 幅度高位
+    band[3] = amp_lf->lf & 0xFF;                    // LF 幅度低字节
+
+    if (write_report(band, is_left) < 0) {
+        // ENODEV = 手柄已断开/节点已失效;关 fd,等 phys_ctlr 重建时重开,
+        // 避免对着死节点持续 write + 刷日志
+        if (errno == ENODEV || errno == EPIPE) {
+            std::cerr << "rumble_hidraw: device gone, closing fd\n";
+            close();
+        } else {
+            std::cerr << "rumble_hidraw: write failed: " << strerror(errno) << "\n";
+        }
+    }
+}
+
+void rumble_hidraw::stop()
+{
+    if (fd < 0)
+        return;
+    // 连发多个中性包:单个包丢失会让手柄持续震动(内核驱动同样连发 5 个)
+    for (int i = 0; i < STOP_PKT_CNT; i++)
+        write_report(NEUTRAL, is_left);
+    last_send_ms = 0;   // 停震后允许下一个 play 立即生效,不被前沿节流吞掉
+}
diff --git a/src/virt_ctlr_combined.cpp b/src/virt_ctlr_combined.cpp
