+/* length_ms=0 表示解除定时(应用主动 stop 后不再补刀) */
+void virt_ctlr_combined::arm_stop_timer(unsigned int length_ms)
+{
+    if (stop_timer_fd < 0)
+        return;
+    struct itimerspec its;
+    memset(&its, 0, sizeof(its));
+    if (length_ms) {
+        its.it_value.tv_sec = length_ms / 1000;
+        its.it_value.tv_nsec = (length_ms % 1000) * 1000000L;
+    }
+    timerfd_settime(stop_timer_fd, 0, &its, NULL);
+}
+
+/* 到点自动停:读清 timerfd,对两只手柄补发中性包 */
+void virt_ctlr_combined::handle_stop_timer()
+{
+    uint64_t expirations;
+    while (read(stop_timer_fd, &expirations, sizeof(expirations)) == sizeof(expirations))
+        ;
+    static bool logged = false;
+    if (!logged) {
+        logged = true;
+        std::cerr << "rumble auto-stop fired (replay timer)" << std::endl;
+    }
+    if (physl && physl->get_rumble().is_open())
+        physl->get_rumble().stop();
+    if (physr && physr->get_rumble().is_open())
+        physr->get_rumble().stop();
+}
